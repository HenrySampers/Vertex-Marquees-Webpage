# Copy this file to .env for local testing only. It is ignored by Git.
# Do not put production credentials in this file unless you deliberately want a real email sent.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888

# Optional: needed only to send a real test email locally.
GMAIL_APP_PASSWORD=

# Optional: needed only to test /admin locally. Generate separate development values.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
